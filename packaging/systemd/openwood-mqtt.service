[Unit]
Description=Charnwood stove MQTT bridge (openwood)
Documentation=https://github.com/trougnouf/openwood
After=bluetooth.target mosquitto.service
Wants=bluetooth.target

[Service]
Type=simple
User=openwood
Group=openwood
# stove registry (see `openwood use`); created once by the admin, e.g.:
#   sudo env OPENWOOD_CONFIG=/etc/openwood/config.json openwood use
Environment=OPENWOOD_CONFIG=/etc/openwood/config.json
Environment=MQTT_HOST=127.0.0.1
Environment=MQTT_POLL_INTERVAL=20
Environment=STATUS_SOURCE=auto
# external thermostat (all optional; see /etc/openwood/mqtt.env)
Environment=EXT_TEMP_TOPIC=
Environment=EXT_TARGET=
Environment=EXT_SETPOINT_LOW=
Environment=EXT_SETPOINT_COMFORT=
Environment=EXT_HYSTERESIS=
Environment=EXT_MIN_INTERVAL=
EnvironmentFile=/etc/openwood/mqtt.env
ExecStart=/usr/bin/openwood mqtt --status-source ${STATUS_SOURCE} --host ${MQTT_HOST} --user ${MQTT_USER} --password ${MQTT_PASSWORD} --name ${STOVE_NAME} --poll-interval ${MQTT_POLL_INTERVAL} --ext-temp-topic ${EXT_TEMP_TOPIC} --ext-target ${EXT_TARGET} --ext-setpoint-low ${EXT_SETPOINT_LOW} --ext-setpoint-comfort ${EXT_SETPOINT_COMFORT} --ext-hysteresis ${EXT_HYSTERESIS} --ext-min-interval ${EXT_MIN_INTERVAL}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
