# /etc/openwood/mqtt.env - settings for openwood-mqtt.service
# Uncomment and edit; restart the service afterwards:
#   sudo systemctl restart openwood-mqtt
#
#MQTT_HOST=127.0.0.1
#MQTT_USER=openwood
#MQTT_PASSWORD=secret
#STOVE_NAME=Charnwood Aire 300
#MQTT_POLL_INTERVAL=20
# Status transport: auto (WiFi if the stove IP is known, else BLE), wifi, ble.
#STATUS_SOURCE=auto
#
# External thermostat: control the stove from a remote temperature sensor
# (e.g. a bedroom upstairs) instead of only the sensor at the stove's
# power cable. EXT_TEMP_TOPIC is any MQTT topic carrying a temperature
# (e.g. a Home Assistant sensor's state topic). Requires EXT_TARGET.
# When the remote sensor is above EXT_TARGET+EXT_HYSTERESIS, the stove
# setpoint drops to EXT_SETPOINT_LOW (default 16 = minimum output);
# at/below EXT_TARGET-EXT_HYSTERESIS it returns to EXT_SETPOINT_COMFORT
# (default: the setpoint the stove was running at startup).
#EXT_TEMP_TOPIC=homeassistant/sensor/bedroom_temperature/state
#EXT_TARGET=21
#EXT_SETPOINT_LOW=16
#EXT_SETPOINT_COMFORT=23
#EXT_HYSTERESIS=0.5
#EXT_MIN_INTERVAL=120
